#!/usr/bin/env python3
"""ccswitcher - switch Claude Code accounts from the command line.

    ccswitcher                 list accounts (* marks the active one; the
                               number in front works as a shorthand)
    ccswitcher ls [--json]
    ccswitcher current [--json]
    ccswitcher use <name> [--json] [-q]
    ccswitcher <name>          same as use <name>

Three shorthands when you would rather not type a name:

    ccswitcher next            switch to the next account (with two accounts,
                               that is simply "the other one")
    ccswitcher use 2           by the number shown in the listing
    ccswitcher -               back to the account you came from (like cd -)

A name can be the custom label, the organization (Team), the email or the
account UUID - case-insensitive, substring allowed. An ambiguous name is
refused rather than guessed: this command swaps credentials, so landing on
the wrong account is worse than asking.

How it works: the request is handed to CCSwitcher.app itself over the
`ccswitcher://` URL scheme, launching it if needed. The switch therefore runs
through exactly the same code path as a menu click, and the keychain sees the
application it already trusts - a separate binary reaching for those items
would prompt for authorization on every machine.

The app writes the outcome to ~/.ccswitcher/cli-result.json; this wrapper
claims its own by nonce, which is what makes the exit code meaningful:

    ccswitcher use Work && claude -p "..."
    test "$(ccswitcher current)" = "Work" || ccswitcher use Work

Exit codes: 0 ok / 1 usage, no match or ambiguous / 2 app unreachable or
timed out / 3 the switch did not take effect.
"""

import json
import os
import subprocess
import sys
import time
import urllib.parse
import uuid

# Messages the wrapper itself produces. Anything coming back from the app is
# already localized there, so only these need a table.
#
# Which language: follow the app, not the shell. `LANG` is routinely C.UTF-8 or
# unset on a Mac whose UI is Chinese, so keying off it would print English next
# to the app's Chinese. Order: explicit override, the app's own setting, then
# the system UI language.
_zh_cache = None


def _zh():
    global _zh_cache
    if _zh_cache is None:
        override = os.environ.get("CCSWITCHER_LANG")
        if override:
            _zh_cache = override.lower().startswith("zh")
        else:
            lang = _defaults_read(["me.xueshi.ccswitcher", "appLanguage"]) or ""
            if not lang or lang == "auto":
                lang = _defaults_read(["-g", "AppleLanguages"]) or ""
            _zh_cache = "zh" in lang.lower()
    return _zh_cache


def _defaults_read(args):
    try:
        r = subprocess.run(["defaults", "read"] + args, capture_output=True, text=True, timeout=5)
        return r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        return None

_MSG = {
    "no_handler": ("No application can handle ccswitcher:// — CCSwitcher is not installed, "
                   "or has never been launched since it was.",
                   "系统找不到能处理 ccswitcher:// 的应用——CCSwitcher 没装，或装完还没启动过一次"),
    "open_failed": ("Could not reach CCSwitcher: {}", "唤起 CCSwitcher 失败：{}"),
    "timeout": ("Timed out waiting for CCSwitcher — it may be busy with another switch, "
                "or stuck starting up.",
                "等 CCSwitcher 回话超时——它可能正忙着另一次切换，或启动被卡住"),
    "no_accounts": ("No accounts saved in CCSwitcher yet.", "CCSwitcher 里还没有保存任何账号"),
    "unknown_current": ("Current account unknown.", "当前账号未知"),
    "usage": ("Usage: ccswitcher use <name|number|next|->", "用法：ccswitcher use <名字|序号|next|->"),
    "no_next": ("Only one account — there is no next one.", "只有一个账号，没有下一个可切"),
    "no_last": ("No previous account yet — switch once before using `-`.",
                "还没有上一个账号可回——先切一次再用 `-`"),
    "last_gone": ("The previous account is no longer in the list.", "上一个账号已经不在列表里了"),
    "out_of_range": ("Number out of range: there are only {} accounts.", "序号超出范围：只有 {} 个账号"),
    "switch_failed": ("Switch failed", "切换失败"),
    "switched": ("Switched to {} ({})", "已切到 {}（{}）"),
    "global_note": ("Takes effect globally: a running claude session bills its next request "
                    "to the new account",
                    "全局生效：正在跑的 claude 会话下一次请求就会记到新账号"),
}


def T(key, *args):
    text = _MSG[key][1 if _zh() else 0]
    return text.format(*args) if args else text


RESULT = os.path.expanduser("~/.ccswitcher/cli-result.json")
# 切走前的账号 id，给 `ccswitcher -` 用。app 不记这个，所以由包装脚本自己存。
LAST = os.path.expanduser("~/.ccswitcher/cli-last")
TIMEOUT = {"use": 45.0, "list": 20.0, "current": 20.0}


def die(msg, code=1):
    print(f"✗ {msg}", file=sys.stderr)
    sys.exit(code)


def call(action, params=None, timeout=None):
    """发一条 ccswitcher:// 指令，等 app 把带同一 nonce 的结果写出来。"""
    nonce = uuid.uuid4().hex
    query = dict(params or {})
    query["nonce"] = nonce
    url = f"ccswitcher://{action}?" + urllib.parse.urlencode(query)

    # -g：别抢焦点，脚本跑起来不该把菜单栏 app 弹到前台
    r = subprocess.run(["open", "-g", url], capture_output=True, text=True)
    if r.returncode != 0:
        err = (r.stderr or "").strip()
        if "Unable to find application" in err or "does not support" in err:
            die(T("no_handler"), 2)
        die(T("open_failed", err or r.returncode), 2)

    deadline = time.time() + (timeout or TIMEOUT.get(action, 20.0))
    while time.time() < deadline:
        try:
            with open(RESULT) as f:
                data = json.load(f)
            if data.get("nonce") == nonce:
                return data
        except (FileNotFoundError, json.JSONDecodeError):
            pass
        time.sleep(0.1)

    die(T("timeout"), 2)


def fmt(accounts):
    for i, a in enumerate(accounts, 1):
        mark = "★" if a.get("active") else " "
        print(f"{mark} {i}. {a.get('label','?'):<16} {a.get('email','?'):<32} {a.get('subscription') or '-'}")


def accounts_now():
    """账号列表 + 当前 active 的下标（没有 active 时为 None）。"""
    accounts = call("list").get("accounts", [])
    if not accounts:
        die(T("no_accounts"), 1)
    active = next((i for i, a in enumerate(accounts) if a.get("active")), None)
    return accounts, active


def remember_previous(accounts, active):
    """记下切走前待着的账号,供 `ccswitcher -` 回头。"""
    if active is None:
        return
    try:
        os.makedirs(os.path.dirname(LAST), exist_ok=True)
        with open(LAST, "w") as f:
            f.write(accounts[active]["id"])
    except OSError:
        pass          # 记不住只是少个便利,不该让切换失败


def main():
    argv = sys.argv[1:]
    as_json = "--json" in argv
    quiet = "-q" in argv or "--quiet" in argv
    argv = [a for a in argv if a not in ("--json", "-q", "--quiet")]

    if argv and argv[0] in ("-h", "--help"):
        print(__doc__)
        return

    cmd = argv[0] if argv else "ls"
    if cmd in ("next", "toggle"):
        cmd, argv = "use", ["use", "next"]
    elif cmd not in ("ls", "current", "use"):
        cmd, argv = "use", ["use"] + argv     # ccswitcher <名字> / ccswitcher 2 / ccswitcher -

    if cmd == "ls":
        data = call("list")
        if as_json:
            print(json.dumps(data.get("accounts", []), ensure_ascii=False, indent=2))
        else:
            fmt(data.get("accounts", []))
        return

    if cmd == "current":
        data = call("current")
        acct = data.get("account") or {}
        if as_json:
            print(json.dumps(acct, ensure_ascii=False, indent=2))
        elif acct:
            print(acct.get("label", "?"))
        else:
            die(data.get("error") or T("unknown_current"), 1)
        return

    # use
    if len(argv) < 2:
        die(T("usage"), 1)
    want = " ".join(argv[1:])

    # 名字之外的三条捷径在本地解成账号 id；名字匹配仍交给 app，免得两边各写一套
    # 匹配规则慢慢长歪。
    if want in ("next", "toggle"):
        accounts, active = accounts_now()
        if len(accounts) < 2:
            die(T("no_next"), 1)
        remember_previous(accounts, active)
        target = accounts[((active or 0) + 1) % len(accounts)]
        data = call("use", {"id": target["id"]})
    elif want == "-":
        try:
            with open(LAST) as f:
                last_id = f.read().strip()
        except OSError:
            die(T("no_last"), 1)
        accounts, active = accounts_now()
        if not any(a["id"] == last_id for a in accounts):
            die(T("last_gone"), 1)
        remember_previous(accounts, active)
        data = call("use", {"id": last_id})
    elif want.isdigit():
        accounts, active = accounts_now()
        n = int(want)
        if not 1 <= n <= len(accounts):
            die(T("out_of_range", len(accounts)), 1)
        remember_previous(accounts, active)
        data = call("use", {"id": accounts[n - 1]["id"]})
    else:
        accounts, active = accounts_now()
        remember_previous(accounts, active)
        data = call("use", {"account": want})

    if as_json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    elif not data.get("ok"):
        print(f"✗ {data.get('error') or T('switch_failed')}", file=sys.stderr)
    elif not quiet:
        acct = data.get("account") or {}
        print("✓ " + T("switched", acct.get("label", "?"), acct.get("email", "?")))
        if data.get("warning"):
            print(f"   ⚠️  {data['warning']}")
        print("   " + T("global_note"))

    if not data.get("ok"):
        sys.exit(3 if data.get("account") else 1)


if __name__ == "__main__":
    main()
